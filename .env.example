# PocketUni Environment Configuration Template
ENVIRONMENT=development
PROJECT_NAME="PocketUni"
API_V1_STR=/api/v1

# PostgreSQL 18 Local Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pocketuni
DB_USER=postgres
DB_PASSWORD="your_postgres_password_here"

# Backward-compatible POSTGRES_* aliases
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pocketuni
POSTGRES_USER=postgres
POSTGRES_PASSWORD="your_postgres_password_here"

# Security & Secrets
SECRET_KEY=pocketuni-insecure-dev-secret-key-change-in-prod-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Administrative Allowlist
SUPER_ADMIN_ALLOWLIST=["utsavkumawat05@gmail.com", "guptamahi0207@gmail.com"]

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_REDIRECT_URI="http://localhost:5173/auth/callback"

# Google Gemini API
GEMINI_API_KEY="your_gemini_api_key_here"

# Local Dev Auth
LOCAL_DEV_AUTH_ENABLED=True
STUDENT_EMAIL_DOMAINS=["mitsgwl.ac.in", "example.invalid"]
FACULTY_EMAIL_DOMAINS=["mitsgwalior.in", "example.invalid"]

# Storage
STORAGE_DIR=storage

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
